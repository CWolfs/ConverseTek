{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CT: Fast Run",
      "command": "${workspaceFolder}/bin/x64/Debug/net472/ConverseTek.exe",
      "type": "shell"
    },
    {
      "label": "CT: Release",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "--configuration",
        "Release",
        "${workspaceFolder}/ConverseTek.csproj",
        "/t:BuildRelease"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CT: Build All",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/ConverseTek.csproj",
        "/t:BuildDebug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CT: Build Server",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/ConverseTek.csproj",
        "/t:BuildServer"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CT: UI Install",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "presentation": {
        "reveal": "always"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "CT: UI Build",
      "type": "shell",
      "command": "npm run build --prefix app && xcopy /y /e /i dist ${workspaceFolder}\\bin\\x64\\Debug\\net472\\dist",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
          "command": "cmd",
          "args": [
              "/C",
              "npm run build --prefix app && xcopy /y /e /i dist ${workspaceFolder}\\bin\\x64\\Debug\\net472\\dist"
          ]
      },
      "presentation": {
          "reveal": "always"
      },
      "group": {
          "kind": "build",
          "isDefault": true
      }
    },
    {
      "label": "CT: Fast Dev",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\start-fast-dev.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "type": "shell",
      "runOptions": {
        "instanceLimit": 5
      }
    },
    {
      "label": "CT: RTool",
      "command": "npm run react-devtools",
      "options": {
        "cwd": "${workspaceFolder}/app/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "type": "shell"
    }
  ]
}
