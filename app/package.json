{
  "name": "conversetek",
  "version": "1.8.0",
  "description": "Conversation editor for Battletech",
  "author": "Richard Griffiths [CWolf] (cwolfs@gmail.com)",
  "license": "GPL-3.0",
  "main": "index.js",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 5173 --no-open",
    "build": "npm run verify && vite build",
    "prod": "vite build --mode production",
    "verify": "npm run ts-check",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "react-devtools": "react-devtools",
    "test": "vitest run",
    "test:watch": "vitest",
    "ts-watch": "tsc --watch",
    "ts-check": "tsc",
    "generate:hooks": "npx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-push": "npm --prefix ./app run verify"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/plugin-proposal-class-properties": "^7.0.0",
