{
  "name": "conversetek",
  "version": "1.8.0",
  "description": "Conversation editor for Battletech",
  "author": "Richard Griffiths [CWolf] (cwolfs@gmail.com)",
  "license": "GPL-3.0",
  "main": "index.js",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 5173 --no-open",
    "build": "npm run verify && vite build",
    "prod": "vite build --mode production",
    "verify": "npm run ts-check",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "react-devtools": "react-devtools",
    "test": "vitest run",
    "test:watch": "vitest",
    "ts-watch": "tsc --watch",
    "ts-check": "tsc",
    "generate:hooks": "npx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-push": "npm --prefix ./app run verify"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.194",
    "@types/lodash.capitalize": "^4.2.7",
    "@types/lodash.debounce": "^4.0.7",
    "@types/lodash.defer": "^4.1.7",
    "@types/lodash.findindex": "^4.6.7",
    "@types/lodash.foreachright": "^4.4.7",
    "@types/lodash.keys": "^4.2.7",
    "@types/lodash.last": "^3.0.7",
    "@types/lodash.remove": "^4.7.7",
    "@types/lodash.sortby": "^4.7.7",
    "@types/lodash.values": "^4.3.7",
    "@types/md5": "^2.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/tinycolor2": "^1.4.6",
    "@types/uuid": "^9.0.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^8.6.5",
    "eslint": "^8.38.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "postcss": "^8.4.21",
    "postcss-assets": "^6.0.0",
    "postcss-calc": "^8.2.4",
    "postcss-import": "^15.1.0",
    "postcss-nested": "^6.0.1",
    "postcss-nested-ancestors": "^3.0.0",
    "postcss-simple-vars": "^7.0.1",
    "react-devtools": "^7.0.1",
    "react-refresh": "^0.14.0",
    "simple-git-hooks": "^2.8.1",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "ahooks": "3.9.7",
    "antd": "^6.3.7",
    "classnames": "^2.3.2",
    "lodash.capitalize": "^4.2.1",
    "lodash.debounce": "^4.0.8",
    "lodash.defer": "^4.1.0",
    "lodash.findindex": "^4.6.0",
    "lodash.foreachright": "^4.4.0",
    "lodash.keys": "^4.2.0",
    "lodash.last": "^3.0.0",
    "lodash.remove": "^4.7.0",
    "lodash.sortby": "^4.7.0",
    "lodash.values": "^4.3.0",
    "md5": "^2.3.0",
    "mobx": "6.15.0",
    "mobx-react": "9.2.1",
    "react": "19.2.5",
    "react-arborist": "3.5.0",
    "react-contexify": "^6.0.0",
    "react-dom": "19.2.5",
    "react-router-dom": "^6.10.0",
    "tinycolor2": "^1.6.0",
    "uuid": "^9.0.0"
  }
}
