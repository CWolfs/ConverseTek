    "@babel/plugin-proposal-numeric-separator": "^7.0.0",
    "@babel/plugin-proposal-throw-expressions": "^7.0.0",
    "@babel/plugin-syntax-dynamic-import": "^7.0.0",
    "@babel/plugin-syntax-import-meta": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.21.4",
    "@types/lodash": "^4.14.194",
    "@types/lodash.capitalize": "^4.2.7",
    "@types/lodash.debounce": "^4.0.7",
    "@types/lodash.defer": "^4.1.7",
    "@types/lodash.difference": "^4.5.7",
    "@types/lodash.findindex": "^4.6.7",
    "@types/lodash.flattendeep": "^4.4.7",
    "@types/lodash.foreachright": "^4.4.7",
    "@types/lodash.keys": "^4.2.7",
    "@types/lodash.last": "^3.0.7",
    "@types/lodash.range": "^3.2.7",
    "@types/lodash.remove": "^4.7.7",
